[Unit]
Description=ASTRA Scheduler Cycle (%i)
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/astra
EnvironmentFile=-/opt/astra/infra/config/astra.env
ExecStart=/opt/astra/venv/bin/python scheduler/autonomous_scheduler.py --timeframe %i
StandardOutput=append:/var/log/astra/scheduler-%i.log
StandardError=append:/var/log/astra/scheduler-%i.log
