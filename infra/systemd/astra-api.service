[Unit]
Description=ASTRA FastAPI Workspace Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/astra
EnvironmentFile=-/opt/astra/infra/config/astra.env
ExecStart=/opt/astra/venv/bin/python workspace/server.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=append:/var/log/astra/api.log
StandardError=append:/var/log/astra/api.log

[Install]
WantedBy=multi-user.target
