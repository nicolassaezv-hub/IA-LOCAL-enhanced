[Unit]
Description=ASTRA Atomic Backup Service
After=local-fs.target

[Service]
Type=oneshot
User=astra
Group=astra
WorkingDirectory=/opt/astra
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/astra/astra.env
ExecStart=/opt/astra/venv/bin/python /opt/astra/infra/backup/create_backup.py --project-root /opt/astra
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/backups/astra /var/log/astra /opt/astra/memory_db
StandardOutput=append:/var/log/astra/backup.log
StandardError=append:/var/log/astra/backup.log
