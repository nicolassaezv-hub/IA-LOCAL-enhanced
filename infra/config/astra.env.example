# ═════════════════════════════════════════════════════════════
# ASTRA v7.1.0 — Configuración de entorno de infraestructura
# Template seguro: NO contiene credenciales reales.
# Instalar como: /etc/astra/astra.env y editar SOLO en el servidor.
# Producción objetivo: Ubuntu 24.04 / ARM64 / Oracle Ampere A1.
# ═════════════════════════════════════════════════════════════

# ── Base de datos ────────────────────────────────────────────
# Motor actual: sqlite
# PostgreSQL puede habilitarse en el futuro si la implementación lo soporta.
ASTRA_DB_ENGINE=sqlite

# Ruta relativa al directorio del proyecto.
ASTRA_DB_PATH=memory_db/astra_autonomous.db
ASTRA_MEMORY_DB_PATH=memory_db/memoria.db
ASTRA_HPARAM_DB_PATH=memory_db/astra_hparam_cache.db
ASTRA_CSV_INDEX_PATH=CSVs/astra_csv_index.json
ASTRA_CIRCUIT_BREAKER_STATE_PATH=memory_db/circuit_breaker_state.json

# ── API / Workplace ─────────────────────────────────────────
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8000
ASTRA_API_HOST=127.0.0.1
ASTRA_API_PORT=8000
# Obligatoria en producción; completar sólo en /etc/astra/astra.env.
ASTRA_API_KEY=
# Opcional para astra_api.py: origins exactos separados por coma, sin wildcard.
ASTRA_CORS_ORIGINS=
ASTRA_LOG_LEVEL=INFO

# ── Scheduler ───────────────────────────────────────────────
ASTRA_SCHEDULER_ENABLED=true
# Contrato productivo fijo; otros valores se ignoran.
ASTRA_ROLLING_WINDOW_SIZE=2000

# Ruta a un JSON de riesgo mantenido fuera del código. Sin este archivo o con
# campos obligatorios incompletos, el sizing direccional falla cerrado.
ASTRA_RISK_CONFIG_PATH=

# ── Monitor / Supervisor ────────────────────────────────────
ASTRA_MONITOR_INTERVAL_SECONDS=30

# ── Backups ─────────────────────────────────────────────────
ASTRA_BACKUP_RETENTION_DAYS=7
ASTRA_BACKUP_ROOT=/var/backups/astra

# ── API Keys ────────────────────────────────────────────────
# Completar en /etc/astra/astra.env o mediante variables del entorno.
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Fuentes de datos ────────────────────────────────────────
YFINANCE_ENABLED=true

# ── MT5 ─────────────────────────────────────────────────────
# Solo Windows + MetaTrader 5. No es requisito en el servidor Linux.
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=

# ── Símbolos soportados (inicial) ──────────────────────────
# Se cargan en la primera ejecución si la base de datos está vacía.
ASTRA_DEFAULT_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD

# ── Directorios del sistema ─────────────────────────────────
# En producción, deploy.sh usa /opt/astra como ASTRA_HOME.
ASTRA_HOME=/opt/astra
ASTRA_ENV_FILE=/etc/astra/astra.env
# Logs:    /var/log/astra/
# Backups: /var/backups/astra/
# systemd/deploy.sh administran estas rutas.
