# ═══════════════════════════════════════════════════
# ASTRA v6.0.1-prod — Configuración del Entorno
# Este archivo define toda la configuración del sistema.
# No hay configuración específica de proveedor de nube.
# Copiar a: infra/config/astra.env y editar antes del despliegue.
# ═══════════════════════════════════════════════════

# ── Base de datos ──
# Motor de base de datos: sqlite (default) | postgresql (futuro)
ASTRA_DB_ENGINE=sqlite
# Ruta a la base de datos SQLite (relativa al directorio del proyecto)
ASTRA_DB_PATH=memory_db/astra_autonomous.db

# ── API / Workspace ──
ASTRA_API_HOST=0.0.0.0
ASTRA_API_PORT=8000
ASTRA_LOG_LEVEL=INFO

# ── Scheduler ──
ASTRA_SCHEDULER_ENABLED=true
ASTRA_ROLLING_WINDOW_SIZE=2000

# ── Monitor / Supervisor ──
ASTRA_MONITOR_INTERVAL_SECONDS=30

# ── Backups ──
ASTRA_BACKUP_RETENTION_DAYS=7

# ── API Keys ──
# Groq (gratis) — https://console.groq.com
GROQ_API_KEY=
# OpenAI (alternativa, opcional)
OPENAI_API_KEY=

# ── Fuentes de datos ──
YFINANCE_ENABLED=true

# ── MT5 (solo Windows + MetaTrader 5) ──
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=

# ── Símbolos soportados (inicial) ──
# Se cargan en la primera ejecución si la base de datos está vacía
ASTRA_DEFAULT_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD

# ── Directorios del sistema (raramente necesitan cambio) ──
# En producción, deploy.sh usa /opt/astra como ASTRA_HOME
# Los logs van a /var/log/astra/ y backups a /var/backups/astra/
# Estos los maneja systemd automáticamente.
