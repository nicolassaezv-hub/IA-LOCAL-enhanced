# ASTRA — ejemplo para desarrollo local
# Copia este archivo a .env y rellena sólo las integraciones que utilices.
# Producción usa infra/config/astra.env.example -> /etc/astra/astra.env.
# NUNCA subas .env a git (ya está en .gitignore).

# ── LLM / IA ────────────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=                      # opcional
ANTHROPIC_API_KEY=                   # opcional

# ── Datos de mercado ─────────────────────────────────────────
# MT5 (solo disponible en Windows con MetaTrader 5 instalado)
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=

# Binance (solo para criptomonedas — opcional)
BINANCE_API_KEY=
BINANCE_SECRET=

# ── Workplace / API ──────────────────────────────────────────
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8000
ASTRA_API_HOST=127.0.0.1
ASTRA_API_PORT=8000
# Requerida al iniciar cualquiera de las APIs protegidas.
ASTRA_API_KEY=
# Optional for astra_api.py: exact comma-separated origins. Wildcards are ignored.
ASTRA_CORS_ORIGINS=

# ── Base de datos / Almacenamiento ───────────────────────────
ASTRA_DB_PATH=memory_db/astra_autonomous.db  # persistencia canónica B1
ASTRA_ROLLING_WINDOW_SIZE=2000       # contrato fijo de producción
ASTRA_RISK_CONFIG_PATH=              # opcional; sin metadata completa, sizing fail-closed

# ── Scheduler ────────────────────────────────────────────────
ASTRA_SCHEDULER_ENABLED=true
ASTRA_SCHEDULER_TZ=UTC

# ── Logging ─────────────────────────────────────────────────
ASTRA_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
ASTRA_LOG_FILE=logs/astra.log        # dejar vacío para stdout

# ── Noticias / Web ───────────────────────────────────────────
NEWS_API_KEY=                        # opcional
SERPER_API_KEY=                      # opcional
TAVILY_API_KEY=                      # opcional

# ── Oracle Cloud / Producción (solo si usas OCI) ─────────────
# La configuración de OCI, red, TLS y reverse proxy no forma parte de este
# ejemplo local ni es inferida por ASTRA.
