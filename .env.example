# ASTRA — Variables de entorno requeridas
# Copia este archivo a .env y rellena los valores reales
# NUNCA subas .env a git (ya está en .gitignore)

# ── LLM / IA ────────────────────────────────────────────────
GROQ_API_KEY=gsk_CHANGE_ME
OPENAI_API_KEY=sk-CHANGE_ME          # opcional
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME   # opcional

# ── Datos de mercado ─────────────────────────────────────────
# MT5 (solo disponible en Windows con MetaTrader 5 instalado)
MT5_ACCOUNT=CHANGE_ME
MT5_PASSWORD=CHANGE_ME
MT5_SERVER=CHANGE_ME

# Binance (solo para criptomonedas — opcional)
BINANCE_API_KEY=CHANGE_ME
BINANCE_SECRET=CHANGE_ME

# ── Workplace / API ──────────────────────────────────────────
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8000
ASTRA_API_HOST=127.0.0.1
ASTRA_API_KEY=
# Optional for astra_api.py: exact comma-separated origins. Wildcards are ignored.
ASTRA_CORS_ORIGINS=
ASTRA_SECRET_KEY=CHANGE_ME_with_a_long_random_string

# ── Base de datos / Almacenamiento ───────────────────────────
ASTRA_DB_PATH=memory.db              # ruta a la base SQLite
ASTRA_MODELS_DIR=models/             # directorio para modelos ML
ASTRA_CSVS_DIR=csvs/                 # directorio para CSVs Forex

# ── Scheduler ────────────────────────────────────────────────
ASTRA_SCHEDULER_ENABLED=true
ASTRA_SCHEDULER_TZ=UTC

# ── Logging ─────────────────────────────────────────────────
ASTRA_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
ASTRA_LOG_FILE=logs/astra.log        # dejar vacío para stdout

# ── Noticias / Web ───────────────────────────────────────────
NEWS_API_KEY=CHANGE_ME               # https://newsapi.org
SERPER_API_KEY=CHANGE_ME             # opcional
TAVILY_API_KEY=CHANGE_ME             # opcional

# ── Oracle Cloud / Producción (solo si usas OCI) ─────────────
# OCI_TENANCY=...
# OCI_USER=...
# OCI_FINGERPRINT=...
# OCI_REGION=...
