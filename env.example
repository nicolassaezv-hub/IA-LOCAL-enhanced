# ASTRA — Variables de entorno requeridas
# Copia este archivo a .env y rellena SOLO los valores que necesites.
# Este archivo debe contener únicamente placeholders y valores no sensibles.
# NUNCA subas .env a Git.

# ── LLM / IA ────────────────────────────────────────────────
# Principal para la configuración actual de ASTRA.
GROQ_API_KEY=

# Proveedores alternativos/opcionales.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Datos de mercado ────────────────────────────────────────
# MT5: solo disponible en Windows con MetaTrader 5 instalado.
# No es requisito de producción en Ubuntu/ARM64.
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=

# Binance: opcional, principalmente para criptomonedas.
BINANCE_API_KEY=
BINANCE_SECRET=

# ── Workplace / API ─────────────────────────────────────────
ASTRA_HOST=0.0.0.0
ASTRA_PORT=8000

# Debe configurarse con un valor aleatorio y privado en .env.
ASTRA_SECRET_KEY=

# ── Base de datos / Almacenamiento ─────────────────────────
ASTRA_DB_PATH=memory.db
ASTRA_MODELS_DIR=models/
ASTRA_CSVS_DIR=csvs/

# ── Scheduler ───────────────────────────────────────────────
ASTRA_SCHEDULER_ENABLED=true
ASTRA_SCHEDULER_TZ=UTC

# ── Logging ─────────────────────────────────────────────────
ASTRA_LOG_LEVEL=INFO
ASTRA_LOG_FILE=logs/astra.log

# ── Noticias / Web ──────────────────────────────────────────
NEWS_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# ── Oracle Cloud / Producción ───────────────────────────────
# El despliegue actual de ASTRA en una VM OCI no requiere que estas
# credenciales se almacenen en el repositorio.
# Si una integración futura con la API de OCI las necesita, deben ir
# únicamente en .env o en un gestor de secretos, nunca aquí.
#
# OCI_TENANCY=
# OCI_USER=
# OCI_FINGERPRINT=
# OCI_REGION=
