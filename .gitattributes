# ASTRA cross-platform line endings

* text=auto

# Linux / production
*.py      text eol=lf
*.sh      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.conf    text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.nix     text eol=lf

# Windows launchers
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.pkl     binary
*.pickle  binary
*.joblib  binary
*.zip     binary